{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "digirise-ai",
  "main": "worker.js",
  "compatibility_date": "2026-10-10",
  "rules": [
    { "type": "Text", "globs": ["private/general-store.html"] }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CONTENT_STORE", "class_name": "ContentStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ContentStore"] }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
