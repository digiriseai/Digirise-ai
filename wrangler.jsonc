{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "digirise-ai",
  "main": "worker.js",
  "compatibility_date": "2026-10-10",
  "rules": [
    {
      "type": "Text",
      "globs": ["private/general-store.html"]
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
